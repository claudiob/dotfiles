[user]
	name = claudiob
	email = claudiob@users.noreply.github.com
[alias]
	co = checkout
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	excludesfile = ~/.gitignore
	editor = mate -w
	autocrlf = input
        paget = less -x4
	pager = less -x3
[apply]
	whitespace = nowarn
[format]
	pretty = %C(yellow)%h%Creset %s %C(red)(%cr, %aN)%Creset
[push]
	default=current
	autoSetupRemote = true
[credentials]
	helper = osxkeychain